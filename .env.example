# Server-side OpenAI project key only. NEVER put it in index.html or a browser app.
OPENAI_API_KEY=

# Text generation and delegated Live reasoning model (must be enabled for your API project).
OPENAI_MODEL=gpt-6.1-terra
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_RESPONSES_MODEL=gpt-5.6-terra

PORT=3000
MAX_CONCURRENT_AI=4
MAX_LIVE_SESSION_CREATIONS=3

# Leave empty for same-origin frontend + backend. For separate hosting, list exact HTTPS origins.
ALLOWED_ORIGINS=

# Only set true when deployed behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
